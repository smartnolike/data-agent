

kubectl get crd sandboxclaims.extensions.agents.x-k8s.io \
  -o jsonpath='{range .spec.versions[*]}{.name}{" served="}{.served}{" storage="}{.storage}{"\n"}{end}'


kubectl api-resources --api-group=extensions.agents.x-k8s.io


kubectl get deploy -A \
  -o custom-columns='NAMESPACE:.metadata.namespace,NAME:.metadata.name,IMAGE:.spec.template.spec.containers[*].image' \
  | grep -i sandbox



kubectl -n danaan-gcp-portal patch deployment \
  danaan-agent-sandbox-router \
  --type='merge' \
  -p '{"spec":{"template":{"metadata":{"labels":{"app":"sandbox-router"}}}}}'


kubectl -n danaan-gcp-portal patch sandboxwarmpool \
  danaan-agent-sandbox-warmpool \
  --type merge \
  -p '{"spec":{"replicas":2}}'


kubectl -n danaan-gcp-portal get pod <剩下的Pod名称> \
  -o jsonpath='{range .metadata.ownerReferences[*]}{.kind}{" / "}{.name}{"\n"}{end}'



gcloud container clusters describe <CLUSTER_NAME> \
  --location <LOCATION> \
  --format="value(networkConfig.datapathProvider)"


gcloud container node-pools describe <SANDBOX_NODE_POOL> \
  --cluster <CLUSTER_NAME> \
  --location <LOCATION> \
  --format="value(config.workloadMetadataConfig.mode)"

curl -v \
  -H "Metadata-Flavor: Google" \
  http://metadata.google.internal/computeMetadata/v1/